<Page
    x:Class="NfaLoader.Pages.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:NfaLoader.Models"
    xmlns:loc="using:NfaLoader.Localization"
    xmlns:controls="using:NfaLoader.Controls"
    NavigationCacheMode="Required">

    <Grid Padding="32,24,32,16" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="4">
                <TextBlock Text="{x:Bind Strings.Get('History_Title'), Mode=OneWay}" Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock
                    x:Name="HistorySummaryText"
                    Text="{x:Bind Strings.Get('History_Subtitle'), Mode=OneWay}"
                    TextWrapping="Wrap"
                    Style="{StaticResource PageSubtitleTextStyle}" />
            </StackPanel>


            <!-- Filters sit together: groups, then search. -->
            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="8"
                VerticalAlignment="Center">
                <ComboBox
                    x:Name="GroupFilterCombo"
                    MinWidth="150"
                    VerticalAlignment="Center"
                    SelectionChanged="GroupFilterCombo_SelectionChanged"
                    ToolTipService.ToolTip="{x:Bind Strings.Get('History_Group_Filter_Tooltip'), Mode=OneWay}" />
                <Button
                    x:Name="ManageGroupsButton"
                    VerticalAlignment="Stretch"
                    Click="ManageGroupsButton_Click"
                    ToolTipService.ToolTip="{x:Bind Strings.Get('History_Group_Manage'), Mode=OneWay}">
                    <FontIcon Glyph="&#xE713;" FontSize="14" />
                </Button>
            </StackPanel>

            <AutoSuggestBox
                x:Name="HistorySearchBox"
                Grid.Column="2"
                Width="240"
                VerticalAlignment="Center"
                PlaceholderText="{x:Bind Strings.Get('History_Search_Placeholder'), Mode=OneWay}"
                QueryIcon="Find"
                TextChanged="HistorySearchBox_TextChanged" />

            <Button
                x:Name="RefreshHistoryButton"
                Grid.Column="3"
                VerticalAlignment="Center"
                Click="RefreshHistoryButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72C;" FontSize="16" />
                    <TextBlock Text="{x:Bind Strings.Get('Common_Refresh'), Mode=OneWay}" />
                </StackPanel>
            </Button>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <Grid RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            x:Name="ImportHistoryButton"
                            Click="ImportHistoryButton_Click"
                            ToolTipService.ToolTip="{x:Bind Strings.Get('History_Import_Tooltip'), Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE77F;" FontSize="16" />
                                <TextBlock Text="{x:Bind Strings.Get('Common_Import'), Mode=OneWay}" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="BatchImportWhiteButton"
                            Click="BatchImportWhiteButton_Click"
                            ToolTipService.ToolTip="{x:Bind Strings.Get('History_WhiteImport_Tooltip'), Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE710;" FontSize="16" />
                                <TextBlock Text="{x:Bind Strings.Get('History_WhiteImport_Button'), Mode=OneWay}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Destructive action: marked red, same as "Clear" on the cached accounts page. -->
                    <Button
                        x:Name="ClearInvalidAccountsButton"
                        Grid.Column="1"
                        Click="ClearInvalidAccountsButton_Click"
                        ToolTipService.ToolTip="{x:Bind Strings.Get('History_ClearInvalid_Tooltip'), Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE894;" FontSize="16" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                            <TextBlock Text="{x:Bind Strings.Get('History_ClearInvalid_Button'), Mode=OneWay}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                        </StackPanel>
                    </Button>

                    <Button
                        x:Name="ClearHistoryButton"
                        Grid.Column="2"
                        Click="ClearHistoryButton_Click"
                        ToolTipService.ToolTip="{x:Bind Strings.Get('History_ClearAll_Tooltip'), Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE75C;" FontSize="16" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                            <TextBlock Text="{x:Bind Strings.Get('Common_Clear'), Mode=OneWay}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                        </StackPanel>
                    </Button>

                </Grid>

                <ListView
                    x:Name="HistoryAccountList"
                    Grid.Row="1"
                    SelectionMode="Single"
                    SelectionChanged="HistoryAccountList_SelectionChanged">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,8" />
                            <Setter Property="CornerRadius" Value="{ThemeResource OverlayCornerRadius}" />
                        </Style>
                    </ListView.ItemContainerStyle>

                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:SteamAccountHistoryItem">
                            <Grid
                                Background="Transparent"
                                PointerEntered="HistoryCard_PointerEntered"
                                PointerExited="HistoryCard_PointerExited">
                                <Border
                                    Padding="12"
                                    CornerRadius="{ThemeResource OverlayCornerRadius}"
                                    BorderThickness="1"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                    <Grid MinHeight="56" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <PersonPicture
                                            Width="48"
                                            Height="48"
                                            VerticalAlignment="Center"
                                            DisplayName="{x:Bind AccountTitle}"
                                            ProfilePicture="{x:Bind AvatarImage, Mode=OneWay}" />

                                        <StackPanel
                                            Grid.Column="1"
                                            Spacing="2"
                                            VerticalAlignment="Center">
                                            <Grid ColumnSpacing="6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    Text="{x:Bind AccountTitle}"
                                                    FontSize="15"
                                                    FontWeight="SemiBold"
                                                    TextTrimming="CharacterEllipsis" />
                                                <FontIcon
                                                    Grid.Column="1"
                                                    Glyph="&#xE70B;"
                                                    FontSize="12"
                                                    VerticalAlignment="Center"
                                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                    Visibility="{x:Bind NoteIndicatorVisibility, Mode=OneWay}"
                                                    ToolTipService.ToolTip="{loc:Localize Key=History_Card_Note_Tooltip}" />
                                            </Grid>
                                            <TextBlock
                                                Text="{x:Bind PersonaDisplayName}"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Text="{x:Bind RemainingCooldownSummaryText, Mode=OneWay}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Text="{x:Bind LastLoginCaptionText}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <StackPanel
                                            Grid.Column="2"
                                            Orientation="Horizontal"
                                            Spacing="6"
                                            VerticalAlignment="Center">
                                            <Button
                                                Style="{StaticResource AccentButtonStyle}"
                                                Padding="9,7"
                                                Click="CardQuickLoginButton_Click"
                                                ToolTipService.ToolTip="{loc:Localize Key=History_Card_QuickLogin}">
                                                <FontIcon Glyph="&#xE8D4;" FontSize="14" />
                                            </Button>
                                            <Button
                                                Padding="9,7"
                                                Click="CardExportButton_Click"
                                                ToolTipService.ToolTip="{loc:Localize Key=History_Card_Copy}">
                                                <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                                            </Button>
                                            <Button
                                                Padding="9,7"
                                                Click="CardDeleteButton_Click"
                                                ToolTipService.ToolTip="{loc:Localize Key=History_Card_Delete}">
                                                <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Checked: black frame around the whole card (high contrast ink border, like common multi-select styles) -->
                                <Border
                                    BorderBrush="{ThemeResource TextFillColorPrimaryBrush}"
                                    BorderThickness="2"
                                    CornerRadius="{ThemeResource OverlayCornerRadius}"
                                    IsHitTestVisible="False"
                                    Visibility="{x:Bind SelectionRingVisibility, Mode=OneWay}" />

                                <!-- 45° corner check indicator in the top left (like photo gallery multi-select): on hover a translucent corner hints at it,
                                     when checked a solid ink triangle + white tick; the sharp corner is clipped by the card's rounded corner.
                                     A chromeless Button (not Tapped) reliably stops a tick click from also selecting the row (detail focus). -->
                                <Button
                                    Width="30"
                                    Height="30"
                                    Margin="0"
                                    Padding="0"
                                    BorderThickness="0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Click="HistoryCardCheck_Click"
                                    ToolTipService.ToolTip="{loc:Localize Key=Common_CheckToBatch}"
                                    Visibility="{x:Bind CheckIndicatorVisibility, Mode=OneWay}">
                                    <Button.Resources>
                                        <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
                                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Transparent" />
                                        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="Transparent" />
                                        <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
                                        <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
                                        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                                        <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
                                    </Button.Resources>
                                    <Grid>
                                        <!-- 45° corner triangle: the top left corner is built into the geometry as an arc matching the card radius (8), not clipped:
                                             Path fills are antialiased, so the diagonal and the arc stay smooth (clipped edges are what get jagged). -->
                                        <Path
                                            Data="M 8,0 L 30,0 L 0,30 L 0,8 A 8,8 0 0 1 8,0 Z"
                                            Stretch="None"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Fill="{ThemeResource TextFillColorPrimaryBrush}"
                                            Opacity="0.35"
                                            Visibility="{x:Bind EmptyCheckCircleVisibility, Mode=OneWay}" />
                                        <Path
                                            Data="M 8,0 L 30,0 L 0,30 L 0,8 A 8,8 0 0 1 8,0 Z"
                                            Stretch="None"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Fill="{ThemeResource TextFillColorPrimaryBrush}"
                                            Visibility="{x:Bind SelectionRingVisibility, Mode=OneWay}" />
                                        <!-- White tick: shown on hover or when checked -->
                                        <FontIcon
                                            Glyph="&#xE73E;"
                                            FontSize="11"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Margin="4,3,0,0"
                                            Foreground="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                                            Visibility="{x:Bind CheckIndicatorVisibility, Mode=OneWay}" />
                                    </Grid>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel
                    x:Name="HistoryEmptyPanel"
                    Grid.Row="1"
                    Spacing="12"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="Collapsed">
                    <FontIcon
                        Glyph="&#xE81C;"
                        FontSize="40"
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock
                        x:Name="HistoryEmptyText"
                        Text="{x:Bind Strings.Get('History_Empty_Title'), Mode=OneWay}"
                        FontSize="16"
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock
                        x:Name="HistoryEmptyHintText"
                        Text="{x:Bind Strings.Get('History_Empty_Hint'), Mode=OneWay}"
                        HorizontalAlignment="Center"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <!-- Batch action bar: appears at the bottom of the list once any card is checked, and acts on all checked accounts -->
                <Border
                    x:Name="BatchActionBar"
                    Grid.Row="1"
                    VerticalAlignment="Bottom"
                    HorizontalAlignment="Stretch"
                    Margin="0,0,0,4"
                    Padding="14,10"
                    Visibility="Collapsed"
                    CornerRadius="{ThemeResource OverlayCornerRadius}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Name="BatchSelectionText"
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            Text="{x:Bind Strings.Get('Common_Selected_Format'), Mode=OneWay}" />
                        <Button
                            x:Name="BatchClearButton"
                            Grid.Column="1"
                            Click="BatchClearButton_Click"
                            Content="{x:Bind Strings.Get('Common_ClearSelection'), Mode=OneWay}" />
                        <Button
                            x:Name="BatchQueryButton"
                            Grid.Column="2"
                            Click="BatchQueryButton_Click"
                            ToolTipService.ToolTip="{x:Bind Strings.Get('History_BatchQuery_Tooltip'), Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE9D9;" FontSize="14" />
                                <TextBlock Text="{x:Bind Strings.Get('Common_BatchQuery'), Mode=OneWay}" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="BatchGroupButton"
                            Grid.Column="3"
                            ToolTipService.ToolTip="{x:Bind Strings.Get('History_BatchGroup_Tooltip'), Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8FD;" FontSize="14" />
                                <TextBlock Text="{x:Bind Strings.Get('Common_BatchGroup'), Mode=OneWay}" />
                            </StackPanel>
                            <Button.Flyout>
                                <MenuFlyout x:Name="BatchGroupFlyout" Opening="BatchGroupFlyout_Opening" />
                            </Button.Flyout>
                        </Button>
                        <Button
                            x:Name="BatchExportButton"
                            Grid.Column="4"
                            Click="BatchExportButton_Click"
                            ToolTipService.ToolTip="{x:Bind Strings.Get('History_BatchExport_Tooltip'), Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                                <TextBlock Text="{x:Bind Strings.Get('Common_BatchExport'), Mode=OneWay}" />
                            </StackPanel>
                        </Button>
                        <!-- Batch delete: destructive, marked red. -->
                        <Button
                            x:Name="BatchDeleteButton"
                            Grid.Column="5"
                            Click="BatchDeleteButton_Click"
                            ToolTipService.ToolTip="{x:Bind Strings.Get('History_BatchDelete_Tooltip'), Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                <TextBlock Text="{x:Bind Strings.Get('Common_BatchDelete'), Mode=OneWay}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </Grid>

            <!-- The details scroll and the actions stay pinned under them, so every button is reachable without scrolling. -->
            <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,18,20,10">
                    <StackPanel Spacing="14">
                        <!-- Same design as the Account Info card on the Login page. -->
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <PersonPicture x:Name="HistoryDetailAvatar" Width="52" Height="52" />
                            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                <TextBlock
                                    x:Name="HistoryDetailPersonaText"
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                    TextTrimming="CharacterEllipsis" />
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <controls:Cs2Icon Kind="Steam" Size="13" VerticalAlignment="Center" />
                                    <TextBlock
                                        x:Name="HistoryDetailSteamIdText"
                                        IsTextSelectionEnabled="True"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <TextBlock
                                    x:Name="HistoryDetailAccountNameText"
                                    Visibility="Collapsed"
                                    TextTrimming="CharacterEllipsis"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </StackPanel>
                        </Grid>

                        <controls:Cs2StatsTiles x:Name="HistoryDetailStats" />

                        <Grid RowSpacing="10" ColumnSpacing="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="92" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <controls:Cs2Icon Kind="Key" Size="16" Margin="0,2,0,0" VerticalAlignment="Top" />
                            <TextBlock Grid.Column="1" Text="{x:Bind Strings.Get('Login_Card_Token'), Mode=OneWay}" Style="{StaticResource FieldLabelTextStyle}" Margin="0,2,0,0" />
                            <StackPanel Grid.Column="2" Spacing="2">
                                <TextBlock x:Name="HistoryDetailAccountStatusText" Style="{StaticResource FieldValueTextStyle}" />
                                <TextBlock
                                    x:Name="HistoryDetailTokenExpiresText"
                                    TextWrapping="Wrap"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <controls:Cs2Icon Grid.Row="1" Kind="Clock" Size="16" Margin="0,2,0,0" VerticalAlignment="Top" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind Strings.Get('History_Detail_Label_LastLogin'), Mode=OneWay}" Style="{StaticResource FieldLabelTextStyle}" Margin="0,2,0,0" />
                            <TextBlock x:Name="HistoryDetailLastLoginText" Grid.Row="1" Grid.Column="2" Style="{StaticResource FieldValueTextStyle}" />

                            <controls:Cs2Icon Grid.Row="2" Kind="Timer" Size="16" Margin="0,2,0,0" VerticalAlignment="Top" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind Strings.Get('Login_Label_Cooldown'), Mode=OneWay}" Style="{StaticResource FieldLabelTextStyle}" Margin="0,2,0,0" />
                            <TextBlock x:Name="HistoryDetailCooldownText" Grid.Row="2" Grid.Column="2" Style="{StaticResource FieldValueTextStyle}" />

                            <controls:Cs2Icon Grid.Row="3" Kind="Vac" Size="16" Margin="0,2,0,0" VerticalAlignment="Top" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{x:Bind Strings.Get('Login_Card_Vac'), Mode=OneWay}" Style="{StaticResource FieldLabelTextStyle}" Margin="0,2,0,0" />
                            <TextBlock x:Name="HistoryDetailVacText" Grid.Row="3" Grid.Column="2" Style="{StaticResource FieldValueTextStyle}" />
                        </Grid>

                        <!-- Only for accounts that came from nfa.pub. Kept out of the grid above so a hidden row leaves no gap. -->
                        <Grid x:Name="HistoryDetailNfaRow" ColumnSpacing="10" Margin="0,-4,0,0" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="92" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <controls:Cs2Icon Kind="Refresh" Size="16" Margin="0,2,0,0" VerticalAlignment="Top" />
                            <TextBlock Grid.Column="1" Text="{x:Bind Strings.Get('Nfa_Label_Replacement'), Mode=OneWay}" Style="{StaticResource FieldLabelTextStyle}" Margin="0,2,0,0" />
                            <StackPanel Grid.Column="2" Spacing="2">
                                <TextBlock x:Name="HistoryNfaHeadline" Style="{StaticResource FieldValueTextStyle}" />
                                <TextBlock
                                    x:Name="HistoryNfaDetail"
                                    TextWrapping="Wrap"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Grid>

                        <TextBox
                            x:Name="HistoryDetailNoteBox"
                            PlaceholderText="{x:Bind Strings.Get('History_Note_Placeholder'), Mode=OneWay}"
                            TextWrapping="Wrap"
                            AcceptsReturn="True"
                            MaxHeight="120"
                            IsSpellCheckEnabled="False"
                            LostFocus="HistoryDetailNoteBox_LostFocus" />

                        <InfoBar
                            x:Name="NfaKeyWarningBar"
                            Severity="Warning"
                            IsClosable="False"
                            Title="{x:Bind Strings.Get('Nfa_Warning_NoKey_Title'), Mode=OneWay}"
                            Message="{x:Bind Strings.Get('Nfa_Warning_NoKey_Message'), Mode=OneWay}">
                            <InfoBar.ActionButton>
                                <Button
                                    Content="{x:Bind Strings.Get('Nfa_Warning_OpenSettings'), Mode=OneWay}"
                                    Click="NfaOpenSettingsButton_Click" />
                            </InfoBar.ActionButton>
                        </InfoBar>
                    </StackPanel>
                    </ScrollViewer>

                    <Border
                        Grid.Row="1"
                        Padding="20,12,20,20"
                        BorderThickness="0,1,0,0"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                        <StackPanel Spacing="8">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <!-- Half-width buttons: the label trims instead of being cut off when Windows text size is raised. -->
                                <Button
                                    x:Name="OneClickHistoryQueryButton"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Click="OneClickHistoryQueryButton_Click"
                                    ToolTipService.ToolTip="{x:Bind Strings.Get('Common_OneClickQuery'), Mode=OneWay}">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="&#xE9D9;" FontSize="16" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind Strings.Get('Common_OneClickQuery'), Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </Button>
                                <Button
                                    x:Name="ReplaceAccountButton"
                                    Grid.Column="1"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Click="ReplaceAccountButton_Click"
                                    ToolTipService.ToolTip="{x:Bind Strings.Get('Nfa_Replace_Tip'), Mode=OneWay}">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="&#xE8AB;" FontSize="16" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind Strings.Get('Nfa_Replace_Button'), Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </Button>
                            </Grid>

                            <!-- The Cancel button is only visible while busy; UpdateControlsEnabled never disables it, so it stays clickable during busy. -->
                            <Button
                                x:Name="CancelHistoryQueryButton"
                                HorizontalAlignment="Stretch"
                                Visibility="Collapsed"
                                Click="CancelHistoryQueryButton_Click"
                                ToolTipService.ToolTip="{x:Bind Strings.Get('History_CancelQuery_Tooltip'), Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE711;" FontSize="16" />
                                    <TextBlock Text="{x:Bind Strings.Get('Common_Cancel'), Mode=OneWay}" />
                                </StackPanel>
                            </Button>

                            <Button
                                x:Name="UseHistoryAccountButton"
                                HorizontalAlignment="Stretch"
                                Style="{StaticResource AccentButtonStyle}"
                                Click="UseHistoryAccountButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8E5;" FontSize="16" />
                                    <TextBlock Text="{x:Bind Strings.Get('History_LoadToLogin_Button'), Mode=OneWay}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <ContentDialog
            x:Name="ImportDialog"
            Title="{x:Bind Strings.Get('History_ImportDialog_Title'), Mode=OneWay}"
            PrimaryButtonText="{x:Bind Strings.Get('History_ImportDialog_Primary'), Mode=OneWay}"
            CloseButtonText="{x:Bind Strings.Get('Common_Cancel'), Mode=OneWay}"
            DefaultButton="Primary">
            <StackPanel Spacing="12" MinWidth="400">
                <TextBlock
                    x:Name="ImportDialogSummaryText"
                    TextWrapping="Wrap"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <ListView
                    x:Name="ImportDialogList"
                    MaxHeight="320"
                    SelectionMode="Multiple"
                    SelectionChanged="ImportDialogList_SelectionChanged">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:AccountImportEntry">
                            <StackPanel Spacing="2" Padding="0,6">
                                <TextBlock Text="{x:Bind AccountName}" FontWeight="SemiBold" />
                                <TextBlock
                                    Text="{x:Bind SummaryText}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock
                                    Text="{x:Bind TokenSummaryText}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </ContentDialog>
    </Grid>
</Page>
