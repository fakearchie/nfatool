<Page
    x:Class="NfaLoader.Pages.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:NfaLoader.Controls"
    NavigationCacheMode="Required">

    <ScrollViewer
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto"
        Padding="32,24,32,16">
        <Grid ColumnSpacing="24" MaxWidth="1280" HorizontalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <StackPanel x:Name="FormPanel" Spacing="20">
                <StackPanel Spacing="4">
                    <TextBlock Text="{x:Bind Strings.Get('Login_Title'), Mode=OneWay}" Style="{StaticResource PageTitleTextStyle}" />
                    <TextBlock
                        Text="{x:Bind Strings.Get('Login_Subtitle'), Mode=OneWay}"
                        Style="{StaticResource PageSubtitleTextStyle}" />
                </StackPanel>

                <SelectorBar x:Name="ModeSelector" SelectionChanged="ModeSelector_SelectionChanged">
                    <SelectorBarItem x:Name="ManualModeItem" Text="{x:Bind Strings.Get('Login_Mode_Manual'), Mode=OneWay}">
                        <SelectorBarItem.Icon>
                            <FontIcon Glyph="&#xE70F;" />
                        </SelectorBarItem.Icon>
                    </SelectorBarItem>
                    <SelectorBarItem x:Name="AutoModeItem" Text="{x:Bind Strings.Get('Login_Mode_Auto'), Mode=OneWay}">
                        <SelectorBarItem.Icon>
                            <FontIcon Glyph="&#xE945;" />
                        </SelectorBarItem.Icon>
                    </SelectorBarItem>
                </SelectorBar>

                <Border x:Name="ManualPanel" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="14">
                        <TextBlock Text="{x:Bind Strings.Get('Login_Manual_Section'), Mode=OneWay}" Style="{StaticResource SectionTitleTextStyle}" />

                        <!-- The token names its own Steam ID, so no separate account name is asked for. -->
                        <TextBox
                            x:Name="EyaTokenBox"
                            Height="150"
                            Header="{x:Bind Strings.Get('Login_Field_EyaToken'), Mode=OneWay}"
                            PlaceholderText="{x:Bind Strings.Get('Login_Field_EyaToken_Placeholder'), Mode=OneWay}"
                            AcceptsReturn="True"
                            TextWrapping="Wrap"
                            IsSpellCheckEnabled="False"
                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                            TextChanged="ManualCredentialBox_TextChanged" />
                    </StackPanel>
                </Border>


                <Border x:Name="AutoPanel" Style="{StaticResource CardBorderStyle}" Visibility="Collapsed">
                    <StackPanel Spacing="14">
                        <TextBlock Text="{x:Bind Strings.Get('Login_Auto_Section'), Mode=OneWay}" Style="{StaticResource SectionTitleTextStyle}" />

                        <InfoBar
                            x:Name="NfaKeyWarningBar"
                            Severity="Warning"
                            IsClosable="False"
                            Title="{x:Bind Strings.Get('Nfa_Warning_NoKey_Title'), Mode=OneWay}"
                            Message="{x:Bind Strings.Get('Nfa_Warning_NoKey_Message'), Mode=OneWay}">
                            <InfoBar.ActionButton>
                                <Button
                                    Content="{x:Bind Strings.Get('Nfa_Warning_OpenSettings'), Mode=OneWay}"
                                    Click="NfaOpenSettingsButton_Click" />
                            </InfoBar.ActionButton>
                        </InfoBar>

                        <!-- A purchase sent but never confirmed. Nothing is re-sent unless the user chooses Finish. -->
                        <InfoBar
                            x:Name="NfaPendingBar"
                            Severity="Warning"
                            IsClosable="False"
                            IsOpen="False"
                            Title="{x:Bind Strings.Get('Nfa_Pending_Title'), Mode=OneWay}">
                            <InfoBar.Content>
                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
                                    <Button
                                        x:Name="NfaFinishPurchaseButton"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Content="{x:Bind Strings.Get('Nfa_Pending_Finish'), Mode=OneWay}"
                                        Click="NfaFinishPurchaseButton_Click" />
                                    <Button
                                        x:Name="NfaDismissPurchaseButton"
                                        Content="{x:Bind Strings.Get('Nfa_Pending_Dismiss'), Mode=OneWay}"
                                        Click="NfaDismissPurchaseButton_Click" />
                                </StackPanel>
                            </InfoBar.Content>
                        </InfoBar>

                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox
                                x:Name="NfaTypeBox"
                                HorizontalAlignment="Stretch"
                                Header="{x:Bind Strings.Get('Nfa_Buy_Field_Type'), Mode=OneWay}"
                                PlaceholderText="{x:Bind Strings.Get('Nfa_Buy_LoadingStock'), Mode=OneWay}" />
                            <Button
                                x:Name="NfaRefreshStockButton"
                                Grid.Column="1"
                                VerticalAlignment="Bottom"
                                Click="NfaRefreshStockButton_Click"
                                ToolTipService.ToolTip="{x:Bind Strings.Get('Nfa_Buy_Refresh_Tip'), Mode=OneWay}">
                                <FontIcon Glyph="&#xE72C;" FontSize="16" />
                            </Button>
                        </Grid>

                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox
                                x:Name="BoughtAccountBox"
                                HorizontalAlignment="Stretch"
                                Header="{x:Bind Strings.Get('Nfa_Buy_Field_Bought'), Mode=OneWay}"
                                PlaceholderText="{x:Bind Strings.Get('Nfa_Buy_NotBought'), Mode=OneWay}"
                                SelectionChanged="BoughtAccountBox_SelectionChanged" />
                            <Button
                                x:Name="BuyButton"
                                Grid.Column="1"
                                MinWidth="112"
                                VerticalAlignment="Bottom"
                                Style="{StaticResource AccentButtonStyle}"
                                Click="BuyButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE7BF;" FontSize="16" />
                                    <TextBlock Text="{x:Bind Strings.Get('Nfa_Buy_Button'), Mode=OneWay}" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <TextBlock
                            x:Name="NfaBalanceText"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- The primary action gets its own row to stand out; the three secondary actions share one row at equal width so they do not compete with the primary button. -->
                <Grid x:Name="ActionButtonGrid" RowSpacing="12" ColumnSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button
                        x:Name="LoginButton"
                        Grid.ColumnSpan="3"
                        HorizontalAlignment="Stretch"
                        Padding="0,12"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="LoginButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8D4;" FontSize="16" />
                            <TextBlock Text="{x:Bind Strings.Get('Login_Btn_Login'), Mode=OneWay}" />
                        </StackPanel>
                    </Button>

                    <Button
                        x:Name="ClearWorkshopButton"
                        Grid.Row="1"
                        HorizontalAlignment="Stretch"
                        Padding="0,10"
                        Click="ClearWorkshopButton_Click"
                        ToolTipService.ToolTip="{x:Bind Strings.Get('Login_Btn_ClearWorkshop_Tip'), Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE74D;" FontSize="16" />
                            <TextBlock Text="{x:Bind Strings.Get('Login_Btn_ClearWorkshop'), Mode=OneWay}" />
                        </StackPanel>
                    </Button>

                    <!-- One-click loadout (the preset saved on the "Loadout" page + the current account's token), replacing the old "Equip R8". -->
                    <Button
                        x:Name="ApplyLoadoutButton"
                        Grid.Row="1"
                        Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        Padding="0,10"
                        Click="ApplyLoadoutButton_Click"
                        ToolTipService.ToolTip="{x:Bind Strings.Get('Login_Btn_ApplyLoadout_Tip'), Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE7C1;" FontSize="16" />
                            <TextBlock Text="{x:Bind Strings.Get('Login_Btn_ApplyLoadout'), Mode=OneWay}" />
                        </StackPanel>
                    </Button>

                    <!-- One-click personalize: applies the nickname+avatar saved on the "Personalize" page to the current account's profile. -->
                    <Button
                        x:Name="PersonalizeButton"
                        Grid.Row="1"
                        Grid.Column="2"
                        HorizontalAlignment="Stretch"
                        Padding="0,10"
                        Click="PersonalizeButton_Click"
                        ToolTipService.ToolTip="{x:Bind Strings.Get('Login_Btn_Personalize_Tip'), Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE779;" FontSize="16" />
                            <TextBlock Text="{x:Bind Strings.Get('Login_Btn_Personalize'), Mode=OneWay}" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- The cancel button is only visible while busy; OnBusyChanged does not disable it, so it can always be clicked while busy. -->
                <Button
                    x:Name="CancelButton"
                    HorizontalAlignment="Stretch"
                    Padding="0,10"
                    Visibility="Collapsed"
                    Click="CancelButton_Click"
                    ToolTipService.ToolTip="{x:Bind Strings.Get('Login_Btn_Cancel_Tip'), Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE711;" FontSize="16" />
                        <TextBlock Text="{x:Bind Strings.Get('Common_Cancel'), Mode=OneWay}" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" VerticalAlignment="Top">
                <StackPanel Spacing="18">
                    <TextBlock Text="{x:Bind Strings.Get('Login_AccountInfo_Section'), Mode=OneWay}" Style="{StaticResource SectionTitleTextStyle}" />

                    <!-- Who: avatar, Steam name, and the Steam ID beside the Steam logo. -->
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <PersonPicture x:Name="AccountInfoAvatar" Width="56" Height="56" />
                        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                            <TextBlock
                                x:Name="AccountInfoPersonaText"
                                FontSize="16"
                                FontWeight="SemiBold"
                                TextTrimming="CharacterEllipsis" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <!-- Steam logo from CS2 (panorama/images/icons/ui/steam_logo_white.svg). -->
                                <controls:Cs2Icon Kind="Steam" Size="13" VerticalAlignment="Center" />
                                <TextBlock
                                    x:Name="AccountInfoSteamIdText"
                                    IsTextSelectionEnabled="True"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <TextBlock
                                x:Name="AccountInfoUserText"
                                Visibility="Collapsed"
                                TextTrimming="CharacterEllipsis"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                    </Grid>

                    <controls:Cs2StatsTiles x:Name="AccountInfoStats" />

                    <!-- Icons from CS2: key, timer, VACnet and refresh (panorama/images/icons/ui). -->
                    <Grid RowSpacing="12" ColumnSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="92" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <controls:Cs2Icon Kind="Key" Size="16" Margin="0,2,0,0" VerticalAlignment="Top" />
                        <TextBlock Grid.Column="1" Text="{x:Bind Strings.Get('Login_Card_Token'), Mode=OneWay}" Style="{StaticResource FieldLabelTextStyle}" Margin="0,2,0,0" />
                        <StackPanel Grid.Column="2" Spacing="2">
                            <TextBlock x:Name="AccountInfoAvailabilityText" Style="{StaticResource FieldValueTextStyle}" />
                            <TextBlock
                                x:Name="AccountInfoExpiresText"
                                TextWrapping="Wrap"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <controls:Cs2Icon Kind="Timer" Size="16" Grid.Row="1" Margin="0,2,0,0" VerticalAlignment="Top" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind Strings.Get('Login_Label_Cooldown'), Mode=OneWay}" Style="{StaticResource FieldLabelTextStyle}" Margin="0,2,0,0" />
                        <TextBlock x:Name="AccountInfoCooldownText" Grid.Row="1" Grid.Column="2" Style="{StaticResource FieldValueTextStyle}" />

                        <controls:Cs2Icon Kind="Vac" Size="16" Grid.Row="2" Margin="0,2,0,0" VerticalAlignment="Top" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind Strings.Get('Login_Card_Vac'), Mode=OneWay}" Style="{StaticResource FieldLabelTextStyle}" Margin="0,2,0,0" />
                        <TextBlock x:Name="AccountInfoVacText" Grid.Row="2" Grid.Column="2" Style="{StaticResource FieldValueTextStyle}" />
                    </Grid>

                    <!-- Only for accounts that came from nfa.pub: one more row in the same layout.
                         Kept out of the grid above so a hidden row leaves no gap. -->
                    <Grid x:Name="AccountInfoNfaRow" ColumnSpacing="10" Margin="0,-6,0,0" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="92" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <controls:Cs2Icon Kind="Refresh" Size="16" Margin="0,2,0,0" VerticalAlignment="Top" />
                        <TextBlock Grid.Column="1" Text="{x:Bind Strings.Get('Nfa_Label_Replacement'), Mode=OneWay}" Style="{StaticResource FieldLabelTextStyle}" Margin="0,2,0,0" />
                        <StackPanel Grid.Column="2" Spacing="2">
                            <TextBlock x:Name="AccountInfoNfaHeadline" Style="{StaticResource FieldValueTextStyle}" />
                            <TextBlock
                                x:Name="AccountInfoNfaDetail"
                                TextWrapping="Wrap"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="AccountInfoActionGrid">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button
                            x:Name="OneClickQueryButton"
                            HorizontalAlignment="Stretch"
                            Click="OneClickQueryButton_Click"
                            ToolTipService.ToolTip="{x:Bind Strings.Get('Login_Btn_OneClickQuery_Tip'), Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE9D9;" FontSize="16" />
                                <TextBlock Text="{x:Bind Strings.Get('Common_OneClickQuery'), Mode=OneWay}" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="AccountInfoReplaceButton"
                            Grid.Column="1"
                            Visibility="Collapsed"
                            Click="AccountInfoReplaceButton_Click"
                            ToolTipService.ToolTip="{x:Bind Strings.Get('Nfa_Replace_Tip'), Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8AB;" FontSize="16" />
                                <TextBlock Text="{x:Bind Strings.Get('Nfa_Replace_Button'), Mode=OneWay}" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
