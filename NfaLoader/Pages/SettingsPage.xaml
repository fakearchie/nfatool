<Page
    x:Class="NfaLoader.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Required">

    <ScrollViewer
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto"
        Padding="32,24,32,16">
        <StackPanel MaxWidth="820" Spacing="14" HorizontalAlignment="Left">
            <StackPanel Spacing="4">
                <TextBlock
                    Text="{x:Bind Strings.Get('Settings_Title'), Mode=OneWay}"
                    Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock
                    Text="{x:Bind Strings.Get('Settings_Subtitle'), Mode=OneWay}"
                    Style="{StaticResource PageSubtitleTextStyle}" />
            </StackPanel>

            <!-- nfa.pub API key. Buying and replacing spend the balance of the account that created it. -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock
                        Text="{x:Bind Strings.Get('Nfa_Settings_Section'), Mode=OneWay}"
                        Style="{StaticResource SectionTitleTextStyle}" />
                    <TextBlock
                        Text="{x:Bind Strings.Get('Nfa_Settings_Desc'), Mode=OneWay}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <PasswordBox
                            x:Name="NfaApiKeyBox"
                            VerticalAlignment="Center"
                            KeyDown="NfaApiKeyBox_KeyDown" />
                        <Button
                            x:Name="NfaSaveKeyButton"
                            Grid.Column="1"
                            MinWidth="96"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="NfaSaveKeyButton_Click"
                            Content="{x:Bind Strings.Get('Nfa_Settings_Save'), Mode=OneWay}" />
                        <Button
                            x:Name="NfaRemoveKeyButton"
                            Grid.Column="2"
                            Click="NfaRemoveKeyButton_Click"
                            Content="{x:Bind Strings.Get('Nfa_Settings_Remove'), Mode=OneWay}" />
                    </Grid>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon x:Name="NfaKeyStateIcon" FontSize="14" Glyph="&#xE946;" />
                            <TextBlock
                                x:Name="NfaKeyStateText"
                                VerticalAlignment="Center"
                                TextWrapping="Wrap"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <HyperlinkButton
                            Grid.Column="1"
                            Padding="4,2"
                            Click="NfaGetKeyButton_Click"
                            Content="{x:Bind Strings.Get('Nfa_Settings_GetKey'), Mode=OneWay}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Theme -->
            <Border Style="{StaticResource CardBorderStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                        <TextBlock
                            Text="{x:Bind Strings.Get('Settings_Theme_Section'), Mode=OneWay}"
                            Style="{StaticResource SectionTitleTextStyle}" />
                        <TextBlock
                            Text="{x:Bind Strings.Get('Settings_Theme_Desc'), Mode=OneWay}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <ComboBox
                        x:Name="ThemeComboBox"
                        Grid.Column="1"
                        MinWidth="180"
                        VerticalAlignment="Center"
                        SelectionChanged="ThemeComboBox_SelectionChanged">
                        <ComboBoxItem Tag="Default" Content="{x:Bind Strings.Get('Settings_Theme_System'), Mode=OneWay}" />
                        <ComboBoxItem Tag="Light" Content="{x:Bind Strings.Get('Settings_Theme_Light'), Mode=OneWay}" />
                        <ComboBoxItem Tag="Dark" Content="{x:Bind Strings.Get('Settings_Theme_Dark'), Mode=OneWay}" />
                    </ComboBox>
                </Grid>
            </Border>

            <!-- Steam install path: the Steam used for sign-in; with several Steam installs you can pick which one to use -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock
                        Text="{x:Bind Strings.Get('Settings_SteamPath_Section'), Mode=OneWay}"
                        Style="{StaticResource SectionTitleTextStyle}" />
                    <TextBlock
                        Text="{x:Bind Strings.Get('Settings_SteamPath_Desc'), Mode=OneWay}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Name="SteamPathText"
                            VerticalAlignment="Center"
                            IsTextSelectionEnabled="True"
                            TextTrimming="CharacterEllipsis"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Button
                            x:Name="ChangeSteamPathButton"
                            Grid.Column="1"
                            Click="ChangeSteamPathButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE838;" FontSize="16" />
                                <TextBlock Text="{x:Bind Strings.Get('Settings_Btn_ChangeSteamPath'), Mode=OneWay}" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- CS2 settings sync: on sign-in, force-push the source account's crosshair, sensitivity, key binds and so on to the target account's Steam Cloud -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock
                                Text="{x:Bind Strings.Get('Settings_Cs2Sync_Section'), Mode=OneWay}"
                                Style="{StaticResource SectionTitleTextStyle}" />
                            <TextBlock
                                Text="{x:Bind Strings.Get('Settings_Cs2Sync_Desc'), Mode=OneWay}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch
                            x:Name="Cs2SyncToggle"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            MinWidth="0"
                            OnContent="{x:Null}"
                            OffContent="{x:Null}"
                            Toggled="Cs2SyncToggle_Toggled" />
                    </Grid>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Text="{x:Bind Strings.Get('Settings_Cs2Sync_Source'), Mode=OneWay}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <AutoSuggestBox
                            x:Name="Cs2SyncSourceBox"
                            Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            QueryIcon="Find"
                            UpdateTextOnSelect="False"
                            PlaceholderText="{x:Bind Strings.Get('Settings_Cs2Sync_Source_Placeholder'), Mode=OneWay}"
                            TextChanged="Cs2SyncSourceBox_TextChanged"
                            QuerySubmitted="Cs2SyncSourceBox_QuerySubmitted"
                            GotFocus="Cs2SyncSourceBox_GotFocus"
                            LostFocus="Cs2SyncSourceBox_LostFocus" />
                        <Button
                            x:Name="Cs2SyncRefreshButton"
                            Grid.Column="2"
                            Click="Cs2SyncRefreshButton_Click"
                            ToolTipService.ToolTip="{x:Bind Strings.Get('Common_Refresh'), Mode=OneWay}">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                        </Button>
                        <Button
                            x:Name="Cs2SyncPushNowButton"
                            Grid.Column="3"
                            Click="Cs2SyncPushNowButton_Click"
                            ToolTipService.ToolTip="{x:Bind Strings.Get('Settings_Cs2Sync_PushNow_Tooltip'), Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE898;" FontSize="14" />
                                <TextBlock Text="{x:Bind Strings.Get('Settings_Cs2Sync_PushNow'), Mode=OneWay}" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <TextBlock
                        Text="{x:Bind Strings.Get('Settings_Cs2Sync_Note'), Mode=OneWay}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Data -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock
                        Text="{x:Bind Strings.Get('Settings_Data_Section'), Mode=OneWay}"
                        Style="{StaticResource SectionTitleTextStyle}" />
                    <TextBlock
                        Text="{x:Bind Strings.Get('Settings_Data_Desc'), Mode=OneWay}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Name="DataFolderPathText"
                            VerticalAlignment="Center"
                            IsTextSelectionEnabled="True"
                            TextTrimming="CharacterEllipsis"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Button
                            x:Name="OpenDataFolderButton"
                            Grid.Column="1"
                            Click="OpenDataFolderButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE838;" FontSize="16" />
                                <TextBlock Text="{x:Bind Strings.Get('Settings_Btn_OpenDataFolder'), Mode=OneWay}" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
