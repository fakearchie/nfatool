<UserControl
    x:Class="NfaLoader.Controls.PremierRatingBadge"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- CS2's Premier rating badge (panorama/images/icons/ui/premier_rating_bg.svg), drawn in its own 178 x 64 space.
         The shapes are grey, as in the game file; the code tints them with the rating's tier color the way the game's
         wash-color does. -->
    <Viewbox Stretch="Uniform">
        <Canvas x:Name="BadgeCanvas" Width="178" Height="64">
            <Path Data="M25 0H21L9 64H13L25 0Z" Fill="#656565" />
            <Path Data="M178 0H33.9996L22 64H166L178 0Z" Fill="#6A6A6A" />
            <Path Data="M176.25 1.5H33.24L21.6562 62.5H164.666L176.25 1.5Z">
                <Path.Fill>
                    <LinearGradientBrush StartPoint="1,0.75" EndPoint="0,0.5">
                        <GradientStop Offset="0.8627" Color="#70444242" />
                        <GradientStop Offset="1" Color="#FF393737" />
                    </LinearGradientBrush>
                </Path.Fill>
            </Path>
            <Path Data="M46.1141 4L54 4L40.8859 61H33L46.1141 4Z" Fill="#707070" Opacity="0.4" />
            <Path Data="M36.7301 4L42 4L30.2699 61H25L36.7301 4Z" Fill="#707070" />
            <Path Data="M56.8737 4L72 4L59.1263 61H44L56.8737 4Z" Fill="#707070" Opacity="0.4" />
            <Path Data="M75.7813 4L110 4L97.2187 61H63L75.7813 4Z" Fill="#707070" Opacity="0.4" />
            <Path Data="M18 0H27L18 64H3.25L18 0Z" Fill="#3A3A3A" />
            <Path Data="M25 0H33L21 64H13L25 0Z" Fill="#E2E2E2" />
            <Path Data="M12 0H20L8 64H0L12 0Z" Fill="#E2E2E2" />

            <!-- No rating: the game shows three dashes (premier_rating_bg_none.svg). -->
            <Path x:Name="NoneDashes" Fill="#FFFFFF"
                  Data="M59.0004 32H81.0004L79.9004 37H57.9004L59.0004 32Z M84.0004 32H106L104.9 37H82.9004L84.0004 32Z M109 32H131L129.9 37H107.9L109 32Z" />

            <!-- The number sits over the body, right of the stripes: big thousands, smaller hundreds, like the game. -->
            <Grid x:Name="ValueGrid" Canvas.Left="30" Width="136" Height="64">
                <StackPanel
                    x:Name="ValueShadow"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Margin="4,4,0,0"
                    Opacity="0.55">
                    <TextBlock x:Name="MajorShadow" FontSize="40" FontWeight="Black" FontStyle="Italic" Foreground="Black" />
                    <TextBlock x:Name="MinorShadow" FontSize="31" FontWeight="Black" FontStyle="Italic" Foreground="Black" Margin="0,0,0,4" VerticalAlignment="Bottom" />
                </StackPanel>
                <StackPanel
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                    <TextBlock x:Name="MajorText" FontSize="40" FontWeight="Black" FontStyle="Italic" />
                    <TextBlock x:Name="MinorText" FontSize="31" FontWeight="Black" FontStyle="Italic" Margin="0,0,0,4" VerticalAlignment="Bottom" />
                </StackPanel>
            </Grid>
        </Canvas>
    </Viewbox>
</UserControl>
