<UserControl
    x:Class="NfaLoader.Controls.Cs2StatsTiles"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:NfaLoader.Controls">

    <!-- CS2 at a glance, drawn with the game's own art: the Premier rating badge and the profile rank insignia. -->
    <Grid ColumnSpacing="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Padding="12,8,12,10" CornerRadius="6" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
            <StackPanel Spacing="6">
                <TextBlock x:Name="PremierLabel" Style="{StaticResource FieldLabelTextStyle}" />
                <controls:PremierRatingBadge x:Name="PremierBadge" Height="34" HorizontalAlignment="Left" />
                <TextBlock
                    x:Name="PremierDetail"
                    TextTrimming="CharacterEllipsis"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Border>

        <Border Grid.Column="1" Padding="12,8,12,10" CornerRadius="6" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
            <StackPanel Spacing="6">
                <TextBlock x:Name="LevelLabel" Style="{StaticResource FieldLabelTextStyle}" />
                <StackPanel Orientation="Horizontal" Spacing="8" Height="34">
                    <Image x:Name="LevelImage" Width="34" Height="34" />
                    <TextBlock x:Name="LevelText" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock
                        x:Name="LevelUnknown"
                        Text="---"
                        FontSize="20"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                </StackPanel>
                <TextBlock
                    x:Name="LevelDetail"
                    TextTrimming="CharacterEllipsis"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
