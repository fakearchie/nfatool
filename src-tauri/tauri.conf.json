{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "nfa.pub tool",
  "version": "0.3.0",
  "identifier": "shop.archievable.desktop",
  "mainBinaryName": "nfa-pub-tool",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "nfa.pub tool",
        "width": 880,
        "height": 560,
        "minWidth": 560,
        "minHeight": 430,
        "resizable": true,
        "center": true,
        "decorations": false,
        "theme": "Dark",
        "backgroundColor": "#191A1E"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
