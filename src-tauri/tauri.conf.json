{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "nfa.pub tool",
  "version": "0.4.0",
  "identifier": "shop.archievable.desktop",
  "mainBinaryName": "nfa-pub-tool",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "nfa.pub tool",
        "width": 880,
        "height": 560,
        "minWidth": 560,
        "minHeight": 430,
        "resizable": true,
        "center": true,
        "decorations": false,
        "theme": "Dark",
        "backgroundColor": "#191A1E"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/fakearchie/nfatool/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMxREU1QjkzOEUxMzAyRkIKUldUN0FoT09rMXZld1ZWQWpKQjJPeEVEK0RGd1NrSE1CQVZmMFUwNENwbjBydDBuam5tcVBEL0sK",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
